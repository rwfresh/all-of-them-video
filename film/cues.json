{
  "note": "One cue sheet for picture and sound. The film's clock is the music's: every position is in beats. shots: in order, each a whole number of bars. prompt: what is typed (in the previous shot's skin) to trigger this shot; Enter lands on this shot's first beat. out: what Claude prints, at local beats. enter: who draws the change into this shot (owner in = this shot, out = the previous one) and how many beats it takes before (pre) and after (post) the bar line. Numbers marked in todo are placeholders until the build gives the real ones.",
  "fps": 60,
  "bpm": 124,
  "beatsPerBar": 4,
  "offset": 0,
  "tailBeats": 0,
  "typing": { "rate": 0.125, "space": 0.25, "lead": 0.5, "clear": 1 },
  "music": { "file": "audio/music/cut/A.wav", "gain": 0.9, "duck": [ { "shot": "synth", "from": 3, "to": 4, "db": -40, "fade": 0.06 } ] },
  "mix": { "sfx": 0.8, "keys": 0.5, "trim": { "boil_strike": 5, "iso_title": 4, "aurora_score": 6, "pixel_crush": 4, "chrome_slam": 2 } },
  "todo": ["cue count and loudness in liquid.out must match tools/mix.mjs (550 cues, -14 LUFS in the final cut)"],
  "shots": [
    { "name": "open", "bars": 2,
      "first": { "text": "make me a video.", "start": 0.25, "rate": 0.125, "space": 0.25, "enter": 3 },
      "out": [ { "at": 3.5, "kind": "say", "text": "In what style?" } ] },

    { "name": "line", "bars": 3, "num": 1, "style": "LINE ART",
      "prompt": "all of them.", "type": { "rate": 0.25, "space": 0.25, "lead": 0.5 },
      "enter": { "owner": "in", "pre": 0, "post": 4 },
      "out": [ { "at": 2, "kind": "tool", "text": "Write(treatment.md)" },
               { "at": 5.5, "kind": "result", "text": "one idea, one line" } ] },

    { "name": "boil", "bars": 3, "num": 2, "style": "FRAME BY FRAME",
      "prompt": "sketch it first.",
      "enter": { "owner": "in", "pre": 0.35, "post": 2 },
      "out": [ { "at": 1.5, "kind": "tool", "text": "Bash(node tools/sheet.mjs all --n 3)" },
               { "at": 6, "kind": "result", "text": "3 stills" } ] },

    { "name": "bauhaus", "bars": 2, "num": 3, "style": "BAUHAUS",
      "prompt": "put it on the beat.",
      "enter": { "owner": "in", "pre": 1, "post": 2 },
      "out": [ { "at": 1, "kind": "tool", "text": "Write(film/cues.json)" },
               { "at": 4, "kind": "result", "text": "40 bars · 160 beats" } ] },

    { "name": "iso", "bars": 2, "num": 4, "style": "ISOMETRIC",
      "prompt": "build the shots.",
      "enter": { "owner": "in", "pre": 0, "post": 2 },
      "out": [ { "at": 0.5, "kind": "tool", "text": "Write(shots/01-line.js)" },
               { "at": 0.75, "kind": "tool", "text": "Write(shots/02-boil.js)" },
               { "at": 1.0, "kind": "tool", "text": "Write(shots/03-bauhaus.js)" },
               { "at": 1.25, "kind": "tool", "text": "Write(shots/04-iso.js)" },
               { "at": 1.5, "kind": "tool", "text": "Write(shots/05-flat.js)" },
               { "at": 1.75, "kind": "tool", "text": "Write(shots/06-morph.js)" },
               { "at": 2.0, "kind": "tool", "text": "Write(shots/07-liquid.js)" },
               { "at": 2.25, "kind": "tool", "text": "Write(shots/08-sticker.js)" },
               { "at": 2.5, "kind": "tool", "text": "Write(shots/09-pixel.js)" },
               { "at": 2.75, "kind": "tool", "text": "Write(shots/10-synth.js)" },
               { "at": 3.0, "kind": "tool", "text": "Write(shots/11-hud.js)" },
               { "at": 3.25, "kind": "tool", "text": "Write(shots/12-collage.js)" },
               { "at": 3.5, "kind": "tool", "text": "Write(shots/13-soft.js)" },
               { "at": 3.75, "kind": "tool", "text": "Write(shots/14-aurora.js)" },
               { "at": 4.0, "kind": "tool", "text": "Write(shots/15-variety.js)" },
               { "at": 5.0, "kind": "result", "text": "15 shots" } ] },

    { "name": "flat", "bars": 2, "num": 5, "style": "FLAT VECTOR",
      "prompt": "give it some bounce.",
      "enter": { "owner": "in", "pre": 0, "post": 2 },
      "out": [ { "at": 1, "kind": "tool", "text": "Update(film/js/util.js)" },
               { "at": 3.5, "kind": "result", "text": "+ overshoot  + squash  + settle" } ] },

    { "name": "morph", "bars": 2, "num": 6, "style": "SHAPE MORPH",
      "prompt": "don't cut. morph.",
      "enter": { "owner": "in", "pre": 0, "post": 2 },
      "out": [ { "at": 1, "kind": "tool", "text": "Write(shots/morph/geo.js)" } ] },

    { "name": "liquid", "bars": 2, "num": 7, "style": "LIQUID",
      "prompt": "pour in the sound.",
      "enter": { "owner": "in", "pre": 0, "post": 2 },
      "out": [ { "at": 0.75, "kind": "tool", "text": "Bash(node tools/sfx.mjs --music)" },
               { "at": 3, "kind": "tool", "text": "Bash(node tools/mix.mjs)" },
               { "at": 4.5, "kind": "result", "text": "550 cues · -14 LUFS" } ] },

    { "name": "sticker", "bars": 3, "num": 8, "style": "STICKER EXPLAINER",
      "prompt": "wait. how does this work?",
      "enter": { "owner": "out", "pre": 1.5, "post": 1 },
      "out": [ { "at": 0.5, "kind": "say", "text": "A film is a web page that can draw any moment." },
               { "at": 4.5, "kind": "say", "text": "Chromium photographs every frame." },
               { "at": 7.5, "kind": "say", "text": "ffmpeg joins them to the sound." } ] },

    { "name": "pixel", "bars": 2, "num": 9, "style": "PIXEL ART",
      "prompt": "render it.",
      "enter": { "owner": "in", "pre": 0, "post": 2 },
      "out": [ { "at": 0.5, "kind": "tool", "text": "Bash(bash tools/build.sh)" },
               { "at": 1.5, "until": 7.5, "kind": "spin", "text": "Rendering…" },
               { "at": 7.5, "kind": "result", "text": "4,646 frames" } ] },

    { "name": "synth", "bars": 3, "num": 10, "style": "SYNTHWAVE",
      "prompt": "play it.", "type": { "rate": 0.25, "space": 0.25, "lead": 1 },
      "enter": { "owner": "in", "pre": 0, "post": 1.5 },
      "out": [ { "at": 1, "until": 3.5, "kind": "tool", "text": "Bash(mpv all-of-them.mp4)" } ] },

    { "name": "hud", "bars": 2, "num": 11, "style": "HUD", "file": "all-of-them_v1.mp4",
      "prompt": "find what's wrong.",
      "enter": { "owner": "in", "pre": 0, "post": 8, "freeze": true },
      "out": [ { "at": 0.75, "kind": "tool", "text": "Agent(jury: score against rubric.md)" },
               { "at": 5, "kind": "result", "text": "7.1 / 10 · 26 fixes" } ] },

    { "name": "collage", "bars": 2, "num": 12, "style": "COLLAGE",
      "prompt": "cut what's boring.",
      "enter": { "owner": "in", "pre": 0, "post": 2 },
      "out": [ { "at": 0.75, "kind": "tool", "text": "Update(shots/01-line.js)" },
               { "at": 1, "kind": "tool", "text": "Update(shots/02-boil.js)" },
               { "at": 1.25, "kind": "tool", "text": "Update(shots/03-bauhaus.js)" },
               { "at": 1.5, "kind": "tool", "text": "Update(shots/04-iso.js)" },
               { "at": 1.75, "kind": "tool", "text": "Update(shots/05-flat.js)" },
               { "at": 2, "kind": "tool", "text": "Update(shots/06-morph.js)" },
               { "at": 2.25, "kind": "tool", "text": "Update(shots/07-liquid.js)" },
               { "at": 2.5, "kind": "tool", "text": "Update(shots/08-sticker.js)" },
               { "at": 2.75, "kind": "tool", "text": "Update(shots/09-pixel.js)" },
               { "at": 3, "kind": "tool", "text": "Update(shots/10-synth.js)" },
               { "at": 3.25, "kind": "tool", "text": "Update(shots/11-hud.js)" },
               { "at": 3.5, "kind": "tool", "text": "Update(shots/12-collage.js)" },
               { "at": 3.75, "kind": "tool", "text": "Update(shots/13-soft.js)" },
               { "at": 4, "kind": "tool", "text": "Update(shots/14-aurora.js)" },
               { "at": 4.25, "kind": "tool", "text": "Update(shots/15-variety.js)" },
               { "at": 5.25, "kind": "result", "text": "26 fixes applied" } ] },

    { "name": "soft", "bars": 2, "num": 13, "style": "3D RENDER",
      "prompt": "now polish it.",
      "enter": { "owner": "in", "pre": 0, "post": 2 },
      "out": [ { "at": 1, "kind": "tool", "text": "Bash(bash tools/finish.sh)" },
               { "at": 4, "kind": "result", "text": "1080p60 · poster · contact sheet" } ] },

    { "name": "aurora", "bars": 2, "num": 14, "style": "AURORA GLASS", "file": "all-of-them_v2.mp4",
      "prompt": "slower. let it breathe.",
      "enter": { "owner": "in", "pre": 0, "post": 2 },
      "out": [ { "at": 1.5, "kind": "tool", "text": "Agent(jury, round 2)" },
               { "at": 5, "kind": "result", "text": "7.3 / 10" } ] },

    { "name": "variety", "bars": 2, "num": 15, "style": "VARIETY CAPTIONS",
      "prompt": "post it.", "type": { "rate": 0.25, "space": 0.25, "lead": 0.5 },
      "enter": { "owner": "in", "pre": 0, "post": 2 },
      "out": [ { "at": 1, "kind": "say", "text": "That part is yours." } ] },

    { "name": "end", "bars": 4,
      "enter": { "owner": "in", "pre": 0, "post": 2 },
      "out": [ { "at": 1.5, "kind": "say", "text": "Your turn." },
